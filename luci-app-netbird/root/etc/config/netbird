
config netbird 'main'
	option enabled '0'
	option management_url 'https://api.netbird.io:443'
	option setup_key ''
	option clear_setup_key '1'
	option hostname ''
	option wireguard_port '51820'
	option log_level 'info'
	option network_monitor '1'
	option disable_dns '1'
	option disable_client_routes '0'
	option disable_server_routes '0'
	option block_inbound '0'
	option allow_server_ssh '0'
	option firewall_zone '1'
	option lan_to_netbird '1'
	option netbird_to_lan '1'
	option masquerade '1'
	option extra_args ''
