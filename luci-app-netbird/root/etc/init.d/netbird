#!/bin/sh /etc/rc.common
# NetBird daemon for GL.iNet / OpenWrt (luci-app-netbird)

START=99
STOP=10
USE_PROCD=1

BIN=/usr/bin/netbird
STATE_DIR=/etc/netbird
LOG_DIR=/var/log/netbird
SOCK=unix:///var/run/netbird.sock

start_service() {
	local enabled log_level
	config_load netbird
	config_get_bool enabled main enabled 0
	config_get log_level main log_level info

	[ "$enabled" = "1" ] || return 0
	[ -x "$BIN" ] || {
		logger -t netbird "binary $BIN missing, install it from LuCI > VPN > NetBird"
		return 1
	}

	mkdir -p "$STATE_DIR" "$LOG_DIR"
	chmod 700 "$STATE_DIR"

	procd_open_instance
	procd_set_param command "$BIN" service run \
		--log-level "$log_level" \
		--log-file "$LOG_DIR/client.log" \
		--daemon-addr "$SOCK"
	procd_set_param env NB_STATE_DIR="$STATE_DIR" NB_LOG_MAX_SIZE_MB=1
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger netbird
}

reload_service() {
	stop
	start
}
